# Copy to .env.local (gitignored) and adjust. Never set these on Render.

# Logged-in users skip /plans premium redirect (routes still require login if they check auth).
DISABLE_PREMIUM_PAYWALL=1

# Optional: password-only premium session at /auth/local-dev-login (loopback only unless ALLOW_LOCAL_DEV_LOGIN=1).
# LOCAL_DEV_LOGIN_PASSWORD=change-me-to-a-long-secret
# LOCAL_DEV_LOGIN_EMAIL=localdev@underdogs.local

# Model performance: v2 backfill is on by default; use DB-only grading with:
# PERFORMANCE_V2_FALLBACK=0
